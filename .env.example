# Server Config
ENVIRONMENT=production
PORT=8000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=cit_scheduler

# Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRE_MINUTES=480

# CORS
FRONTEND_ORIGINS=http://localhost:5173,https://cit-scheduler.vercel.app
FRONTEND_ORIGIN_REGEX=https://.*\.vercel\.app

# LLM Provider (gemini | anthropic | openai | none)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Solver Configuration
SOLVER_TIME_LIMIT_SECONDS=60
SOLVER_WORKERS=2
SEED_ON_STARTUP=true

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SHOW_DEMO_ACCOUNTS=true
